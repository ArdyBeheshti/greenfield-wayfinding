# Copy to .env.local for local development (never commit .env.local).
# In production, set these in Vercel → Project → Settings → Environment Variables.
# Mappedin's public demo credentials: https://developer.mappedin.com/docs/demo-keys-and-maps

# Mappedin Maker maps ("Demo Key & Maker Maps")
MAPPEDIN_KEY=
MAPPEDIN_SECRET=

# Mappedin CMS / enterprise maps ("Demo Key & CMS Maps for Mappedin Enterprise")
MAPPEDIN_ENTERPRISE_KEY=
MAPPEDIN_ENTERPRISE_SECRET=
